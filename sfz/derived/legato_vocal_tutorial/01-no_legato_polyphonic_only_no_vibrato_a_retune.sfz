// retuned copy of ../../../instruments/legato_vocal_tutorial/Programs/01-no_legato_polyphonic_only_no_vibrato_a.sfz (flux-sfz retune): per-sample tune= measured against pitch_keycenter
//Very very basic patch - polyphonic vowel sustains
//No start samples or vibrato or anythin like that
//Only dynamics, width and release time controls

<control>
default_path=../../../instruments/legato_vocal_tutorial/Programs/
label_cc1=Dynamics
label_cc31=Width
label_cc107=Release
set_cc1=63.5
set_cc31=127
set_cc107=13

<global>
/* #include "modules/controls/common.sfz" (inlined) */
off_mode=time
off_time=0.4
ampeg_attack=0.03
ampeg_release=0.2
ampeg_release_oncc107=1
amp_veltrack=0
amplitude_oncc1=100
amplitude_smoothcc1=120
amplitude_curvecc1=10
width=0
width_oncc31=100
/* #include "modules/controls/dyn_eq.sfz" (inlined) */
//EQ setup so dynamics affects timbre, with zero effect when mod wheel is in the middle
eq1_freq=1500
eq1_bw=2
eq1_gain=-2
eq1_gain_oncc1=4
eq1_freq_oncc1=1000
eq2_bw=3 //Wide and gentle high band
eq2_freq=5000
eq2_gain=-1
eq2_gain_oncc1=2
eq3_freq=150 //And we boost lows with low mod wheel, cut with high mod wheel to make quiet notes warmer
eq3_bw=2
eq3_gain=2.5
eq3_gain_oncc1=-5


//A vowel, poly
<master>
/* #include "modules/vowel_sustain_a.sfz" (inlined) */
<region>
tune=3
sample=../Samples/vowel_sustain/a/vowel_a_d3.wav
lokey=50
hikey=50
pitch_keycenter=50

<region>
tune=-4
sample=../Samples/vowel_sustain/a/vowel_a_eb3.wav
lokey=51
hikey=51
pitch_keycenter=51

<region>
