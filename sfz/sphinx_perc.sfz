<region> sample=VSCO-2-CE/Percussion/Quinto-HitN_v3_rr2_Sum.wav lovel=101 hivel=127

<group> key=39 amp_veltrack=70
<region> sample=VSCO-2-CE/Percussion/Quinto-Tap1_v1_rr1_Sum.wav lorand=0   hirand=0.5
<region> sample=VSCO-2-CE/Percussion/Quinto-Tap1_v1_rr2_Sum.wav lorand=0.5 hirand=1

<group> key=40 amp_veltrack=60 seq_length=2 seq_position=1
