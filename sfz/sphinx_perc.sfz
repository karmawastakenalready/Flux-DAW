<region> sample=VSCO-2-CE/Percussion/Conga-HitN_v2_rr1_Sum.wav lovel=61 hivel=100
<region> sample=VSCO-2-CE/Percussion/Conga-HitN_v3_rr1_Sum.wav lovel=101 hivel=127
<group> key=40 amp_veltrack=60 seq_length=2 seq_position=2
<region> sample=VSCO-2-CE/Percussion/Conga-HitN_v1_rr2_Sum.wav lovel=0  hivel=60
<region> sample=VSCO-2-CE/Percussion/Conga-HitN_v2_rr2_Sum.wav lovel=61 hivel=100
<region> sample=VSCO-2-CE/Percussion/Conga-HitN_v3_rr2_Sum.wav lovel=101 hivel=127

<group> key=41 amp_veltrack=70
<region> sample=VSCO-2-CE/Percussion/Conga-Tap1_v1_rr1_Sum.wav lorand=0   hirand=0.5
<region> sample=VSCO-2-CE/Percussion/Conga-Tap1_v1_rr2_Sum.wav lorand=0.5 hirand=1

<group> key=43 amp_veltrack=60 seq_length=2 seq_position=1
<region> sample=VSCO-2-CE/Percussion/Tumba-HitN_v1_rr1_Sum.wav lovel=0  hivel=60
<region> sample=VSCO-2-CE/Percussion/Tumba-HitN_v2_rr1_Sum.wav lovel=61 hivel=100
<region> sample=VSCO-2-CE/Percussion/Tumba-HitN_v3_rr1_Sum.wav lovel=101 hivel=127
<group> key=43 amp_veltrack=60 seq_length=2 seq_position=2
<region> sample=VSCO-2-CE/Percussion/Tumba-HitN_v1_rr2_Sum.wav lovel=0  hivel=60
<region> sample=VSCO-2-CE/Percussion/Tumba-HitN_v2_rr2_Sum.wav lovel=61 hivel=100
<region> sample=VSCO-2-CE/Percussion/Tumba-HitN_v3_rr2_Sum.wav lovel=101 hivel=127

