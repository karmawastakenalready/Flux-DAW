<group> key=42 amp_veltrack=70 seq_length=2 seq_position=1
<region> sample=VSCO-2-CE/Percussion/Tamb1-Hit_v1_rr1_Sum.wav lovel=0  hivel=84
<region> sample=VSCO-2-CE/Percussion/Tamb1-Hit_v2_rr1_Sum.wav lovel=85 hivel=127
