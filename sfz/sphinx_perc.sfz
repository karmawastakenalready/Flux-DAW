<region> sample=VSCO-2-CE/Percussion/Tamb1-Roll_v2_rr1_Sum.wav lovel=61 hivel=100
<region> sample=VSCO-2-CE/Percussion/Tamb1-Roll_v3_rr1_Sum.wav lovel=101 hivel=127

// ---------- tabla strokes (Sonic Pi samples, CC0) ----------
<group> key=49 amp_veltrack=70
<region> sample=sonic-pi-samples/etc/samples/tabla_ghe1.flac lorand=0     hirand=0.125
<region> sample=sonic-pi-samples/etc/samples/tabla_ghe2.flac lorand=0.125 hirand=0.25
<region> sample=sonic-pi-samples/etc/samples/tabla_ghe3.flac lorand=0.25  hirand=0.375
<region> sample=sonic-pi-samples/etc/samples/tabla_ghe4.flac lorand=0.375 hirand=0.5
<region> sample=sonic-pi-samples/etc/samples/tabla_ghe5.flac lorand=0.5   hirand=0.625
<region> sample=sonic-pi-samples/etc/samples/tabla_ghe6.flac lorand=0.625 hirand=0.75
<region> sample=sonic-pi-samples/etc/samples/tabla_ghe7.flac lorand=0.75  hirand=0.875
<region> sample=sonic-pi-samples/etc/samples/tabla_ghe8.flac lorand=0.875 hirand=1

