<region> sample=VSCO-2-CE/Percussion/Tamb1-Shake_v1_rr1_Sum.wav lorand=0   hirand=0.5
<region> sample=VSCO-2-CE/Percussion/Tamb1-Shake_v1_rr2_Sum.wav lorand=0.5 hirand=1

<group> key=46 amp_veltrack=60
